{
  "manifest_version": 3,
  "name": "ChatGPT Chat Cleanup",
  "version": "0.9.0",
  "description": "Select chats under 'Your chats' in the ChatGPT sidebar and delete them in bulk with fast, safe concurrency and clear progress feedback.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ]
}